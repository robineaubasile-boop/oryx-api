{
  "e0": "ip-special-registry",
  "fmt": 1,
  "protocol": "E0-V0.1c",
  "sources": [
    "IANA IPv4 Special-Purpose Address Registry (iana-ipv4-special-registry), colonne Globally Reachable",
    "IANA IPv6 Special-Purpose Address Registry (iana-ipv6-special-registry), colonne Globally Reachable",
    "IANA IPv4 Multicast Address Space (224.0.0.0/4) ; IANA IPv6 Multicast Address Space (ff00::/8)",
    "IANA IPv6 Address Space : seul 2000::/3 est attribué à l'unicast global"
  ],
  "rules": {
    "match": "préfixe le plus spécifique contenant l'adresse",
    "global_ipv4": "aucune entrée, ou entrée la plus spécifique avec globally_reachable = true",
    "global_ipv6": "adresse dans ipv6_global_unicast_space ET (aucune entrée, ou entrée la plus spécifique avec globally_reachable = true)",
    "not_applicable": "globally_reachable = null (N/A, déprécié) est traité comme NON global (règle E0 conservatrice)",
    "clear_text": "une adresse n'est écrite en clair que si l'entrée la plus spécifique porte clear = true ; toute autre adresse (globale, sans entrée, ou embarquant une IPv4 : Teredo, 6to4, NAT64) est pseudonymisée",
    "ipv4_mapped": "::ffff:0:0/96 est toujours de classe F ; la confidentialité est évaluée sur l'IPv4 interne"
  },
  "ipv6_global_unicast_space": "2000::/3",
  "ipv4": [
